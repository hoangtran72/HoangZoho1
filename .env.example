# Commit-safe template. Copy to .env.azure.local for deployment preparation.
# Naming: <CUSTOMER>_<SERVICE>_<CREDENTIAL>, uppercase snake case.
# Never put real credentials in this tracked file.
CONFIGURATION_NOTIFICATION_EMAIL=replace-with-your-email-address
# Optional production fallback switch. The fallback file must be uploaded separately
# to the application's content root and must never be committed.
ALLOW_LOCAL_SECRET_FALLBACK=false
LOCAL_SECRET_FILE_PATH=

# Paste the normal/raw AWS values exactly as AWS displays them. Do not Base64-encode them.
AWS_ACCESS_KEY_ID=replace-with-raw-aws-access-key-id
